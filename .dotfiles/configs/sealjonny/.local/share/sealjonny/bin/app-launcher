#!/bin/bash

launch_cmd() {
  local app="$1"
  shift # Remove $1 from args
  if ! command -v "$app" &> /dev/null; then
    exit 127
  fi

  exec uwsm-app -- "$app" "$@"
}

launch_flatpak() {
  local app="$1"
  shift # Remove $1 from args

  if ! command -v flatpak &> /dev/null || ! flatpak info "$app" &> /dev/null; then
    exit 127
  fi

  exec uwsm-app -- flatpak run "$app" "$@"
}

if ! command -v uwsm-app &> /dev/null; then
  exit 127
fi

if [[ "$1" == "-f" ]]; then
  shift
  launch_flatpak "$@"
else
  launch_cmd "$@"
fi
