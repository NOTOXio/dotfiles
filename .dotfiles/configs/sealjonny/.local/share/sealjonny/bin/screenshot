#!/usr/bin/env bash

opt=""
case "$1" in
  region) opt="region" ;;
  window) opt="window" ;;
  monitor) opt="output" ;;
esac

if [[ -z "$opt" ]]; then
  exit 1
fi

image="$(hyprshot -m "$opt" --freeze --raw 2> /dev/null | base64 -w0)"

if [[ -z "$image" ]]; then
  exit 0
fi

base64 -d <<<"$image" | wl-copy --type image/png
