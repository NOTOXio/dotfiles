#!/usr/bin/env bash

print_logo() {
  cat << 'EOF'
 ▄█     █▄   ▄█     ▄████████    ▄████████    ▄██████▄  ███    █▄     ▄████████    ▄████████ ████████▄  
███     ███ ███    ███    ███   ███    ███   ███    ███ ███    ███   ███    ███   ███    ███ ███   ▀███ 
███     ███ ███▌   ███    ███   ███    █▀    ███    █▀  ███    ███   ███    ███   ███    ███ ███    ███ 
███     ███ ███▌  ▄███▄▄▄▄██▀  ▄███▄▄▄      ▄███        ███    ███   ███    ███  ▄███▄▄▄▄██▀ ███    ███ 
███     ███ ███▌ ▀▀███▀▀▀▀▀   ▀▀███▀▀▀     ▀▀███ ████▄  ███    ███ ▀███████████ ▀▀███▀▀▀▀▀   ███    ███ 
███     ███ ███  ▀███████████   ███    █▄    ███    ███ ███    ███   ███    ███ ▀███████████ ███    ███ 
███ ▄█▄ ███ ███    ███    ███   ███    ███   ███    ███ ███    ███   ███    ███   ███    ███ ███   ▄███ 
 ▀███▀███▀  █▀     ███    ███   ██████████   ████████▀  ████████▀    ███    █▀    ███    ███ ████████▀  
                   ███    ███                                                     ███    ███            
EOF
}

vpn_exist() {
  nmcli -g TYPE connection show | grep -x "wireguard" &> /dev/null
}

vpn_get_all() {
  nmcli -g NAME,UUID,TYPE connection show | awk -F: '$3=="wireguard" { print $1, $2 }'
}

vpn_up() {
  nmcli connection up "$1" &> /dev/null
}

vpn_down() {
  nmcli connection down "$1" &> /dev/null
}

vpn_active() {
  nmcli -g TYPE connection show --active | grep -x "wireguard" &> /dev/null
}

vpn_get_active() {
  nmcli -g UUID,TYPE connection show --active | awk -F: '$2=="wireguard" { print $1 }'
}

vpn_get_active_name() {
  nmcli -g NAME,TYPE connection show --active | awk -F: '$2=="wireguard" { print $1 }'
}

vpn_get_name() {
  local uuid="$1"
  nmcli -t -f connection.id connection show "$uuid" | awk -F: '{ print $2 }'
}

json() {
  local alt="$1"
  local tooltip="$2"

  echo "{\"alt\":\"$alt\",\"tooltip\":\"$tooltip\"}"
}

notify() {
  notify-send --icon "$HOME/.local/share/sealjonny/icons/wireguard.svg" --expire-time 1500 "$1"
}

vpn_status() {
  if ! vpn_exist; then
    json "disconnected" "No VPN configured"
    exit 0
  fi

  if ! vpn_active; then
    json "disconnected" "VPN disconnected"
    exit 0
  fi

  json "connected" "Connected to $(vpn_get_active_name)"
}

vpn_connect() {
  if ! vpn_exist || vpn_active; then
    exit 1
  fi

  local choice
  local height="${VPN_FZF_HEIGHT:-40%}"
  local fzf_args="--header-first --min-height=1 --layout=reverse --color=header:green"
  choice="$(vpn_get_all | fzf --height "$height" --header="$(print_logo)" $fzf_args | awk '{ print $2 }')"

  if [[ -z "$choice" ]]; then
    exit 0
  fi

  local ssid
  ssid="$(vpn_get_name "$choice")"
  if vpn_up "$choice"; then
    notify "Connected to $ssid" 
  else
    notify "Failed to connect to $ssid" 
  fi
}

vpn_disconnect() {
  if ! vpn_active; then
    exit 0
  fi

  local active
  active="$(vpn_get_active)"
  if [[ -z "$active" ]]; then
    exit 1
  fi

  local ssid
  ssid="$(vpn_get_name "$active")"
  if vpn_down "$active"; then
    notify "Disconnected from $ssid"
  else
    notify "Failed to disconnect from $ssid"
  fi
}

vpn_toggle() {
  if vpn_active; then
    vpn_disconnect
  else
    vpn_connect
  fi
}

main() {
  local cmd="${1-}"

  if ! command -v nmcli &> /dev/null; then
    exit 1
  fi

  if [[ -z "$cmd" ]]; then
    cmd="toggle"
  fi

  case "$cmd" in
    s|status) vpn_status ;;
    c|connect) vpn_connect ;;
    d|disconnect) vpn_disconnect ;;
    t|toggle) vpn_toggle ;;
  esac
}

main "$@"
