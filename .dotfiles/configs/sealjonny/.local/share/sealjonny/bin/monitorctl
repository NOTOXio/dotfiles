#!/bin/bash

config_file="$HOME/.config/hypr/monitors.conf"

get_monitor_config() {
  local monitor_config
  monitor_config="$(cat "$config_file" | grep "eDP-1")"
  monitor_config="${monitor_config#monitor=}"

  echo "$monitor_config"
}

turn_on() {
  hyprctl keyword monitor "$(get_monitor_config)"
}

turn_off() {
  hyprctl keyword monitor "eDP-1, disable"
}

if [[ ! -f "$config_file" ]]; then
  exit 1
fi

case "$1" in
  on) turn_on ;;
  off) turn_off ;;
esac
