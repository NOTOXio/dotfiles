# Shorten common apps
alias e="micro"
alias g="git"
alias d="docker"
alias c="bat"

# Replace ls with eza
alias ls="eza --group-directories-first --color=auto"

alias ll="ls -la"
alias lt="eza --tree --level=2 --icons=auto --group-directories-first"

# Clipboard
alias copy="wl-copy"
alias paste="wl-paste"

# Print external ip
alias externalip="curl -sS https://www.daveeddy.com/ip"
