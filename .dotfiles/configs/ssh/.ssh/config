# SSH-Config (Dotfiles). Hier stehen keine Hosts, nur Includes:
#   ~/.ssh/claude.d/*               Claudes Lesezugänge zum Homelab (eine Datei pro Alias,
#                                   angelegt von setup-claude-ssh.sh bzw. dem Skill "homelab")
#   ~/dev/homelab/host/ssh/config   eigene Homelab-Aliase (pve, ct-*) aus dem Repo NOTOXio/homelab
# Fehlende Dateien ignoriert ssh, die Config funktioniert also auch ohne Homelab-Klon.
Include ~/.ssh/claude.d/*
Include ~/dev/homelab/host/ssh/config
